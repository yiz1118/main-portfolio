# No environment variables are required to build or run the portfolio preview.
# Real canonical origin (HTTPS); leave empty until a domain is selected.
SITE_URL=
# Preview shows draft projects. Production hides them.
SITE_MODE=preview
# Enable only after real content, domain and launch checks are complete.
SITE_INDEXING=false
# Server-side email settings. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Verified sender, e.g. Developer <hello@your-verified-domain.com>
CONTACT_FROM=
CONTACT_TO=
# In production, confirm deployment-level rate limiting before delivery is enabled.
CONTACT_RATE_LIMIT_READY=false
