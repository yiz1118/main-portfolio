{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-public/types/**/*.ts",
    ".next-public/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Portfolio website/01 - Premium Restaurant  Fine Dining Website",
    "Portfolio website/04 — Architecture  Luxury Property Website",
    "Portfolio website/05 — Beauty  Skincare  Wellness E-Commerce",
    "Portfolio website/06 — Automotive  Performance Car Website"
  ]
}
